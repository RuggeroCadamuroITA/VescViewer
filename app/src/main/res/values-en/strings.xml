    <string name="setup_welcome_title">Welcome to VescViewer</string>
    <string name="setup_welcome_thanks">Thanks for downloading the app!</string>
    <string name="setup_welcome_body">VescViewer turns your phone into a dashboard for your VESC: real-time telemetry over Bluetooth Low Energy, read-only. Before you start, let\'s set the few options you need to read correct data.</string>
    <string name="setup_welcome_steps">Six steps: language, appearance, units, vehicle, alerts and summary. You can\'t skip them — at the end the app is set up for you.</string>
    <string name="setup_github_label">Source code and updates on GitHub</string>
    <string name="setup_github_author">RuggeroCadamuroITA/VescViewer</string>
    <string name="setup_start">Start setup</string>
    <string name="setup_language_title">Choose your language</string>
    <string name="setup_language_desc">The interface switches to the language you tap right away.</string>
    <string name="setup_theme_title">Theme and accent colour</string>
    <string name="setup_theme_desc">Choose how the app looks: tap a theme and an accent colour.</string>
    <string name="setup_units_title">Units</string>
    <string name="setup_units_desc">How you want to read speed and temperature.</string>
    <string name="setup_vehicle_title">Vehicle and battery</string>
    <string name="setup_vehicle_desc">They are needed to turn ERPM into speed, count distance and compute the battery percentage. If you don\'t know them, keep the defaults: you can change them later in settings.</string>
    <string name="setup_vehicle_confirm">I confirm these values</string>
    <string name="setup_summary_title">All set</string>
    <string name="setup_summary_desc">Check the summary and start: you can change everything in settings, except the app icon, which is the official VescViewer one.</string>
