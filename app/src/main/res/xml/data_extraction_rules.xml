<?xml version="1.0" encoding="utf-8"?>
<!--
    Ride locations and PIN authentication metadata are intentionally local-only;
    other app preferences remain transferable so the user does not lose setup.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="vesc_viewer.db" />
        <exclude domain="sharedpref" path="vesc_viewer_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="vesc_viewer.db" />
        <exclude domain="sharedpref" path="vesc_viewer_auth.xml" />
    </device-transfer>
</data-extraction-rules>
